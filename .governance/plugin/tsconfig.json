{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "index.ts",
    "types.ts",
    "config-loader.ts",
    "hooks/**/*.ts",
    "../capabilities/handoff-provider/index.ts",
    "../capabilities/handoff-provider/types.ts",
    "../capabilities/rule-appender/index.ts",
    "../capabilities/rule-appender/types.ts",
    "../capabilities/git-checker/index.ts",
    "../capabilities/git-checker/types.ts",
    "../capabilities/snapshot-writer/index.ts",
    "../capabilities/snapshot-writer/types.ts"
  ]
}
