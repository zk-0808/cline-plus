{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Runtime Snapshot",
  "description": "Machine-written snapshot by snapshot-writer capability (PreCompact hook). Read by handoff-provider (SessionStart hook).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "compacted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when PreCompact hook fired"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "summary": {"type": "string"},
          "confidence": {"type": "string", "enum": ["Verified", "Likely", "Hypothesis"]},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["id", "summary", "confidence"]
      }
    },
    "active_todos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "summary": {"type": "string"},
          "status": {"type": "string"}
        },
        "required": ["id", "summary"]
      }
    },
    "files_changed": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of files modified in the compacted session segment"
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Next session's first actions in order"
    }
  },
  "required": ["schema_version", "session_id", "compacted_at"]
}
