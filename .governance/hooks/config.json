{
  "session-start": {
    "enabled": true,
    "capabilities": {
      "handoffProvider": {
        "enabled": true,
        "args": {
          "handoffPath": "HANDOFF.md",
          "snapshotPath": ".governance/runtime/snapshot.json",
          "constitutionPath": ".governance/core/constitution.md",
          "rulesDir": ".governance/rules/"
        }
      },
      "gitChecker": {
        "enabled": true,
        "args": {
          "threshold": 5,
          "excludePatterns": [
            "node_modules/",
            "dist/",
            ".git/"
          ]
        }
      }
    }
  },
  "pre-tool": {
    "enabled": true,
    "skipTools": [
      "read_file",
      "list_dir",
      "grep_search",
      "codebase_search",
      "glob_file_search"
    ],
    "capabilities": {
      "gitChecker": {
        "enabled": true,
        "args": {
          "threshold": 5,
          "excludePatterns": [
            "node_modules/",
            "dist/",
            ".git/"
          ]
        }
      }
    }
  },
  "post-tool": {
    "enabled": false,
    "customChecks": []
  },
  "pre-compact": {
    "enabled": true,
    "capabilities": {
      "snapshotWriter": {
        "enabled": true,
        "args": {
          "snapshotPath": ".governance/runtime/snapshot.json"
        }
      }
    }
  },
  "tracing": {
    "enabled": true,
    "args": {
      "tracePath": ".governance/runtime/traces.jsonl",
      "consoleOutput": false
    }
  }
}
